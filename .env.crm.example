# Add these values to the private .env; never commit actual values.
# Calls remain opt-in; credentials are supplied privately, never by the browser.
NEWT_CALLS_ENABLED=false
NEWT_ISOLATION_CALLS_ENABLED=false
PORTAL_SECRET_KEY=replace-with-an-independent-long-random-secret
ASSURANCE_SECRET_KEY=replace-with-an-independent-long-random-secret
ASSURANCE_ACCESS_KEY=replace-with-an-independent-long-random-signing-key
ISOLATION_ACCESS_KEY=replace-with-an-independent-long-random-signing-key
PORTAL_DB_NAME=amx_portal
PORTAL_DB_USER=amx_portal
PORTAL_DB_PASSWORD=replace-with-a-strong-independent-password
ASSURANCE_DB_NAME=amx_assurance
ASSURANCE_DB_USER=amx_assurance
ASSURANCE_DB_PASSWORD=replace-with-a-strong-independent-password

# Assurance booking availability bridge (Compose sets http://portal:8000).
PORTAL_INTERNAL_URL=http://127.0.0.1:8090
