# Configuration de production CRM Orvia.
# Ce modèle est rempli par : python3 scripts/generate_production_env.py VOTRE-DOMAINE
# Le fichier .env obtenu reste sur le serveur : ne jamais le committer ni l'envoyer par e-mail.
# Les clés et mots de passe sont générés automatiquement et ne doivent plus changer ensuite
# (sinon les sessions, les e-mails chiffrés et les MFA existants deviennent illisibles).

# --- Domaine (rempli par le script) ---
DEBUG=false
CALLVERIFY_DOMAIN=__DOMAIN__
ALLOWED_HOSTS=__DOMAIN__
CORS_ALLOWED_ORIGINS=https://__DOMAIN__
FRONTEND_URL=https://__DOMAIN__
PORTAL_PUBLIC_URL=https://__DOMAIN__

# --- Clés internes (générées, à conserver aussi dans un coffre-fort) ---
SECRET_KEY=__SECRET__
PORTAL_SECRET_KEY=__SECRET__
ASSURANCE_SECRET_KEY=__SECRET__
ASSURANCE_ACCESS_KEY=__SECRET__
ISOLATION_ACCESS_KEY=__SECRET__
ASSURANCE_MAIL_BRIDGE_KEY=__SECRET__
MFA_ENCRYPTION_KEY=__FERNET__
PORTAL_MAIL_KEY=__FERNET__
PORTAL_CALENDAR_KEY=__FERNET__

# --- Bases de données (mots de passe générés ; serveurs internes à Docker) ---
POSTGRES_DB=callverify
POSTGRES_USER=callverify
POSTGRES_PASSWORD=__SECRET__
PORTAL_DB_NAME=amx_portal
PORTAL_DB_USER=amx_portal
PORTAL_DB_PASSWORD=__SECRET__
ASSURANCE_DB_NAME=amx_assurance
ASSURANCE_DB_USER=amx_assurance
ASSURANCE_DB_PASSWORD=__SECRET__
REDIS_URL=redis://redis:6379/0
CELERY_EAGER=false

# --- E-mails (À REMPLIR : invitations, mots de passe oubliés, rappels) ---
# Fournisseur SMTP de votre domaine (Google Workspace, Microsoft 365, Brevo, Mailgun...).
PORTAL_EMAIL_HOST=
PORTAL_EMAIL_PORT=587
PORTAL_EMAIL_USER=
PORTAL_EMAIL_PASSWORD=
PORTAL_EMAIL_TLS=true
PORTAL_FROM_EMAIL=Orvia <no-reply@__DOMAIN__>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Orvia <no-reply@__DOMAIN__>

# --- Téléphonie NEWT (facultatif : laisser false tant que les appels ne sont pas ouverts) ---
NEWT_USERNAME=
NEWT_PASSWORD=
NEWT_CALLS_ENABLED=false
NEWT_ISOLATION_CALLS_ENABLED=false
# true : le poste du setter décroche tout seul quand le CRM lance l'appel (option NEWT).
NEWT_AUTO_ANSWER=false
NEWT_DIRECTORY_ENABLED=false
NEWT_STATUS_ENABLED=false
NEWT_CDR_SCHEMA_ENABLED=false
# true active aussi le rapprochement automatique des durées (service « newt-journal »).
NEWT_CDR_HISTORY_ENABLED=false

# --- Agendas externes (facultatif) ---
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_TENANT=common
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_WEBHOOK_SIGNING_KEY=

# --- Vérification des numéros Isolation par Twilio (facultatif) ---
LOOKUP_ENABLED=false
LOOKUP_PACKAGES=
LOOKUP_UNIT_COST=0.01
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
VOICE_CALLBACK_URL=

# --- Stockage de fichiers externe (facultatif ; sinon volume Docker local) ---
S3_BUCKET=
AWS_REGION=ca-central-1
S3_ENDPOINT_URL=
