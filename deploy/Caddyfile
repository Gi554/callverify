{$CALLVERIFY_DOMAIN} {
    # Service-to-service routes are signed, and also never reachable from the internet.
    # Longer paths sort before the general handlers below.
    handle /api/portal/internal/* {
        respond 404
    }
    handle /api/assurance/internal/* {
        respond 404
    }
    handle /api/portal/* {
        reverse_proxy portal:8000
    }
    handle /api/assurance/* {
        reverse_proxy assurance:8000
    }
    handle_path /api/isolation/* {
        rewrite * /api{uri}
        reverse_proxy api:8000
    }
    handle /api/* {
        reverse_proxy api:8000
    }
    handle {
        reverse_proxy web:80
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
}
